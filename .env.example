# Optional: add env vars here when you add APIs
# NEXT_PUBLIC_API_URL=
# NEXT_PUBLIC_GA_ID=

# Core database/auth
APP_BASE_URL="http://localhost:3000"
DATABASE_URL="postgresql://user:pass@host:5432/dbname?schema=public"
AUTH_SECRET="replace-with-long-random-secret"
# Separate secret for internal GET /api/health/admin-bootstrap (x-health-key header). Do not reuse AUTH_SECRET.
# HEALTH_CHECK_SECRET="replace-with-different-long-random-secret"
GOOGLE_CLIENT_ID="google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="google-oauth-client-secret"

# Initial admin bootstrap (prisma seed only — never created implicitly at login)
# ADMIN_BOOTSTRAP_MOBILE=9999999999
# ADMIN_BOOTSTRAP_EMAIL=admin@eyekra.com
# ADMIN_BOOTSTRAP_PASSWORD=ChangeThisAdminPassword!

# Upstash Redis (OTP + rate limit)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Cloudflare R2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=eyekra-uploads                       # optional common bucket for all uploads
# R2_BUCKET_UPLOADS=eyekra-uploads               # optional alias for common bucket
# R2_BUCKET_BANNERS=eyekra-banners
# R2_BUCKET_CATEGORY_ICONS=eyekra-category-icons
# R2_BUCKET_PRESCRIPTIONS=eyekra-prescriptions
# R2_PUBLIC_BASE_URL=https://cdn.example.com     # used for public image URLs
# R2_PRIVATE_BASE_URL=https://private-cdn.example.com # prescription URLs (fallback: public base)

# Backblaze B2 / any S3-compatible alternative (optional; use instead of R2 creds)
# B2_ENDPOINT=https://s3.<region>.backblazeb2.com
# B2_REGION=<region>                              # e.g. us-west-004
# B2_ACCESS_KEY_ID=
# B2_SECRET_ACCESS_KEY=
# S3_ENDPOINT=                                    # generic alias (if not using B2_* names)
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Web push (PWA/TWA push notifications)
# Generate with: npx web-push generate-vapid-keys
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_SUBJECT=mailto:support@eyekra.com

# Google Places (address autocomplete in Saved address / Add address)
# Get key: Google Cloud Console → APIs & Services → enable Maps JavaScript API + Places API
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Partner system (Optom field-force defaults)
# PARTNER_GEOFENCE_RADIUS_METERS=50
# PARTNER_GEOFENCE_CENTER_LAT=28.6139
# PARTNER_GEOFENCE_CENTER_LNG=77.2090
# PARTNER_AUDIO_BUCKET=eyekra-partner-audio
# PARTNER_INCENTIVE_PER_COMPLETED_BOOKING=25
# PARTNER_INCENTIVE_DISTANCE_PER_KM=2
